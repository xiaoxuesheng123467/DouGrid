<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DouGrid.Base" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/dougrid_surface</item>
        <item name="android:colorAccent">@color/dougrid_teal</item>
        <item name="android:statusBarColor">@color/dougrid_surface</item>
        <item name="android:navigationBarColor">@color/dougrid_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDisablePreview">false</item>
    </style>

    <style name="Theme.DouGrid" parent="Theme.DouGrid.Base" />

    <style name="Theme.DouGrid.Starting" parent="Theme.DouGrid">
        <item name="android:windowBackground">@drawable/launch_screen</item>
    </style>
</resources>
